.min-h-screen.flex.items-center.justify-center
  .w-full style="max-width: 400px"
    / Header
    .mb-8.text-center
      h1 class="text-2xl font-semibold tracking-tight mb-1" Sign in to StockVal
      p class="text-sm text-[#666]" Enter your credentials to continue

    / Flash messages
    - if flash[:alert]
      .mb-4 class="bg-[#ff4d4d]/10 border border-[#ff4d4d]/20 text-[#ff4d4d] text-sm px-4 py-3 rounded-lg"
        = flash[:alert]
    - if flash[:notice]
      .mb-4 class="bg-[#00d4aa]/10 border border-[#00d4aa]/20 text-[#00d4aa] text-sm px-4 py-3 rounded-lg"
        = flash[:notice]

    / Card
    .p-8 class="bg-[#111] border border-[#222] rounded-xl"
      = form_with url: session_path do |form|
        .mb-4
          = form.label :email_address, "Email", class: "block text-xs font-medium text-[#666] uppercase tracking-widest mb-2"
          = form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address]
        .mb-6
          = form.label :password, "Password", class: "block text-xs font-medium text-[#666] uppercase tracking-widest mb-2"
          = form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72
        = form.submit "Sign in"

    .mt-4.text-center
      = link_to "Forgot password?", new_password_path, class: "text-sm text-[#666] hover:text-[#00d4aa] transition-colors"