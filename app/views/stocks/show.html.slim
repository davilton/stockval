/ Back link
.mb-6
  = link_to "← Search another stock", stocks_path, class: "text-sm text-[#666] hover:text-[#00d4aa] transition-colors"

/ Header
.mb-8
  .flex.items-start.justify-between
    div
      .flex.items-center.gap-3.mb-1
        h1 class="text-3xl font-semibold tracking-tight" = @stock.ticker
        span class="text-sm px-2 py-1 rounded bg-[#111] border border-[#222] text-[#666]" = @stock.exchange
      p class="text-[#666] text-lg" = @stock.name
      p class="text-sm text-[#444] mt-1" = "#{@stock.sector} · #{@stock.industry}"
    / Rating badge
    div
      - rating = @valuation.rating
      span class="text-sm font-semibold px-4 py-2 rounded-lg #{rating[:color] == 'positive' ? 'bg-[#00c076]/10 text-[#00c076] border border-[#00c076]/20' : rating[:color] == 'danger' ? 'bg-[#ff4d4d]/10 text-[#ff4d4d] border border-[#ff4d4d]/20' : 'bg-[#666]/10 text-[#666] border border-[#666]/20'}"
        = "#{rating[:label]} · #{@valuation.score}/16"

/ Key stats row
.grid.mb-8 style="grid-template-columns: repeat(4, 1fr); gap: 1px; background: #222"
  - [["P/E Ratio", @stock.pe_ratio], ["EPS", "$#{@stock.eps}"], ["Profit Margin", "#{(@stock.profit_margin.to_f * 100).round(1)}%"], ["Return on Equity", "#{(@stock.roe.to_f * 100).round(1)}%"]].each do |label, value|
    .p-5 class="bg-[#0a0a0a]"
      p class="text-xs text-[#666] uppercase tracking-widest mb-1" = label
      p class="text-xl font-semibold tabular" = value

/ Two column layout
.grid.gap-6.mb-8 style="grid-template-columns: 1fr 1fr"

  / Pillar breakdown
  .rounded-xl.overflow-hidden class="bg-[#111] border border-[#222]"
    .px-6.py-4 class="border-b border-[#222]"
      h2 class="text-sm font-semibold uppercase tracking-widest text-[#666]" Pillar Breakdown
    - @valuation.breakdown.each do |pillar, score|
      .flex.items-center.justify-between.px-6.py-4 class="border-b border-[#222] last:border-0"
        p class="text-sm" = pillar.to_s.humanize
        .flex.items-center.gap-3
          .flex.gap-1
            - 2.times do |i|
              .w-3.h-3.rounded-sm class=(i < score ? (score == 2 ? 'bg-[#00c076]' : 'bg-[#00d4aa]') : 'bg-[#222]')
          span class="text-xs text-[#666] w-6 text-right" = "#{score}/2"

  / Fundamentals
  .rounded-xl.overflow-hidden class="bg-[#111] border border-[#222]"
    .px-6.py-4 class="border-b border-[#222]"
      h2 class="text-sm font-semibold uppercase tracking-widest text-[#666]" Fundamentals
    - @fundamentals.each do |label, value|
      .flex.items-center.justify-between.px-6.py-4 class="border-b border-[#222] last:border-0"
        p class="text-sm text-[#666]" = label
        p class="text-sm font-medium tabular" = value

/ Analyst ratings
.rounded-xl.overflow-hidden.mb-8 class="bg-[#111] border border-[#222]"
  .px-6.py-4 class="border-b border-[#222]"
    h2 class="text-sm font-semibold uppercase tracking-widest text-[#666]" Analyst Ratings
  .grid.px-6.py-6 style="grid-template-columns: repeat(5, 1fr)"
    - @analyst_ratings.each do |label, count, color|
      .text-center
        p class="text-2xl font-semibold tabular" style="color: #{color}" = count
        p class="text-xs text-[#666] mt-1" = label

/ Footer meta
.flex.items-center.justify-between
  p class="text-xs text-[#444]" = "Last updated #{@stock.last_fetched_at.strftime('%b %d, %Y at %H:%M')}"
  = link_to "Refresh data", stock_path(@stock.ticker), class: "text-xs text-[#666] hover:text-[#00d4aa] transition-colors"