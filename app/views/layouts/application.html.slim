doctype html
html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
    title StockVal

  body class="bg-[#0a0a0a] text-[#f5f5f5] font-sans antialiased min-h-screen"
    nav class="border-b border-[#222] px-6 py-0"
      .max-w-6xl.mx-auto.flex.items-center.justify-between style="height: 56px"

        .flex.items-center style="gap: 2rem"
          = link_to root_path, class: "text-base font-semibold tracking-tight" do
            span class="text-[#00d4aa]" StockVal
          - if authenticated?
            = link_to "Watchlist", "#", class: "nav-link"
            = link_to "Explore", stocks_path, class: "nav-link"

        - if authenticated?
          = form_with url: stocks_search_path, method: :get do |f|
            = f.text_field :ticker, placeholder: "Search ticker...", class: "nav-search"

        - if authenticated?
          .flex.items-center style="gap: 0.75rem"
            .nav-avatar = Current.user.email_address
        
            .w-px.h-4.bg-[#222]
            = button_to "Sign out", session_path, method: :delete, class: "nav-signout"
        - else
          = link_to "Sign in", new_session_path, class: "text-sm text-[#00d4aa]"







    main class="max-w-6xl mx-auto px-6 py-10"
      = yield

    footer class="border-t border-[#222] px-6 py-6 mt-20"
      .max-w-6xl.mx-auto
        p class="text-xs text-[#444] text-center" Not financial advice. For educational purposes only.